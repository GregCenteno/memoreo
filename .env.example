# Copia este archivo a pwa-app/.env si vas a probar Stripe y/o el correo con
# Resend localmente usando `netlify dev` (ver README.md, "Desplegar en
# Netlify") — la Netlify CLI también lee este archivo, además de Vite.

# --- Base de datos real (Supabase) — ver README.md, "Base de datos real
# (Supabase)". Sin estas, la app no puede iniciar sesión, guardar
# documentos ni subir archivos adjuntos.
#
# VITE_SUPABASE_URL y VITE_SUPABASE_ANON_KEY las usa el navegador (Vite las
# incluye en el build porque empiezan con VITE_) — no son secretas, la
# seguridad real la dan las políticas de Row Level Security del esquema.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-llave-anon-publica

# SUPABASE_URL (mismo valor que arriba, sin el prefijo VITE_) y
# SUPABASE_SERVICE_ROLE_KEY las usan SOLO las funciones de Netlify del lado
# del servidor (netlify/functions/admin-metrics.mjs, delete-account.mjs,
# webhook.mjs) — la service_role key es secreta de verdad: nunca debe
# llevar el prefijo VITE_ (eso la mandaría al navegador) ni guardarse en
# ningún archivo que se suba a un repositorio o se comparta.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-llave-service-role-secreta

# --- Solo necesario para las funciones de Netlify (netlify/functions/) ---
# Los mismos valores que usarías en el dashboard de Netlify una vez
# desplegado (Project configuration → Environment variables).
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_PREMIUM_PLUS=price_...

RESEND_API_KEY=re_...
RESEND_FROM=Memoreo <onboarding@resend.dev>

# Usuario y contraseña del panel de administrador (admin.html) — ver
# README.md, "Cómo funciona el panel de administrador". Sin estas dos
# variables, /api/admin-metrics responde con error 500 y el panel no deja
# entrar a nadie.
ADMIN_USERNAME=elige-un-usuario
ADMIN_PASSWORD=elige-una-contraseña-larga

# --- Solo necesario si usas el servidor Express independiente de /server
# en vez de las funciones de Netlify (ver server/.env.example) ---
# VITE_API_BASE=http://localhost:4242
